use cli
use valk.core

fn git_like() cli.App {
    let app = cli.App.new("vcs", "A version control system", "2.0.0")
    app.root.flag("quiet", "q", "Say less")

    let add = cli.Command.new("add", "Add files to the next commit")
    add.argument("files", "The files to add", true, true)
    add.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        return ctx.args("files").length.to(i32)
    })

    let remote = cli.Command.new("remote", "Work with remotes")
    let remote_add = cli.Command.new("add", "Add a remote")
    remote_add.argument("name", "Its name", true)
    remote_add.argument("url", "Where it lives", true)
    remote_add.option("branch", "b", "The branch to follow", "main")
    remote_add.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        if ctx.arg("name") == "origin" && ctx.value("branch") == "main" : return 0
        return 1
    })
    remote.command(remote_add)

    app.root.command(add)
    app.root.command(remote)
    return app
}

test "Subcommands" {
    let app = git_like()

    // The command that was named is the one that runs
    let ctx = app.parse(args(.{ "add", "one.txt", "two.txt" })) ! { println(E.message) assert(false) return }
    assert(ctx.command.name == "add")
    assert(ctx.args("files").length == 2)
    assert(ctx.command.path() == "vcs add")

    // Commands under commands
    let deep = app.parse(args(.{ "remote", "add", "origin", "git@example.com:repo.git" })) ! {
        println(E.message)
        assert(false)
        return
    }
    assert(deep.command.path() == "vcs remote add")
    assert(deep.arg("name") == "origin")
    assert(deep.arg("url") == "git@example.com:repo.git")
    assert(deep.value("branch") == "main")

    // Running returns what the command returns
    assert(app.run(args(.{ "add", "a", "b", "c" })) == 3)
    assert(app.run(args(.{ "remote", "add", "origin", "url" })) == 0)
    assert(app.run(args(.{ "remote", "add", "upstream", "url" })) == 1)

    // A subcommand after the options of its parent
    let quiet = app.parse(args(.{ "-q", "remote", "add", "origin", "url" })) ! {
        println(E.message)
        assert(false)
        return
    }
    assert(quiet.command.path() == "vcs remote add")
    assert(quiet.flag("quiet"))
    assert(quiet.arg("name") == "origin")

    // A command that does not exist, with the nearest one offered
    app.parse(args(.{ "remove", "x" })) ! {
        assert(error_is(E.code, unknown_command))
        assert(E.message.contains("Did you mean 'remote'"))
        return
    }
    assert(false)
}

test "Help and version" {
    let app = git_like()

    // `--help` anywhere answers with the help of the command it follows
    let root_help = app.parse(args(.{ "--help" })) ! { assert(false) return }
    assert(root_help.help_asked)
    let sub_help = app.parse(args(.{ "remote", "add", "--help" })) ! { assert(false) return }
    assert(sub_help.help_asked)
    assert(sub_help.command.path() == "vcs remote add")

    // Asking for help does not ask for the arguments the command needs
    let without_args = app.parse(args(.{ "remote", "add", "-h" })) ! { println(E.message) assert(false) return }
    assert(without_args.help_asked)

    let version = app.parse(args(.{ "--version" })) ! { assert(false) return }
    assert(version.version_asked)

    // Both answer 0
    assert(app.run(args(.{ "--help" })) == 0)
    assert(app.run(args(.{ "--version" })) == 0)
}

synctest "Help text" {
    cli.colors = false
    let app = git_like()
    let text = app.help()

    assert(text.contains("A version control system"))
    assert(text.contains("Usage:"))
    assert(text.contains("vcs [options] <command>"))
    assert(text.contains("Commands:"))
    assert(text.contains("add"))
    assert(text.contains("Add files to the next commit"))
    assert(text.contains("Options:"))
    assert(text.contains("-q, --quiet"))
    assert(text.contains("-h, --help"))
    assert(text.contains("--version"))
    assert(text.contains("Version 2.0.0"))

    // A subcommand shows its own arguments and options
    let remote_add = app.root.find("remote") ?! {
        assert(false)
        return
    }
    let sub = remote_add.find("add") ?! {
        assert(false)
        return
    }
    let sub_text = cli.help_text(sub)
    assert(sub_text.contains("vcs remote add [options] <name> <url>"))
    assert(sub_text.contains("<name>"))
    assert(sub_text.contains("Its name"))
    assert(sub_text.contains("-b, --branch <value>"))
    assert(sub_text.contains("[default: main]"))
    // A subcommand does not offer --version
    assert(!sub_text.contains("--version"))
}

synctest "Environment variables" {
    let app = cli.App.new("tool", "", "")
    app.root.option("token", "t", "The token to use", "", "token", "TOOL_TOKEN")
    app.root.flag("debug", "d", "Say more", "TOOL_DEBUG")

    core.setenv("TOOL_TOKEN", "from-env") ! { assert(false) return }
    core.setenv("TOOL_DEBUG", "1") ! { assert(false) return }

    let ctx = app.parse(args(.{})) ! { println(E.message) assert(false) return }
    assert(ctx.value("token") == "from-env")
    assert(ctx.flag("debug"))

    // What is typed wins over the environment
    let typed = app.parse(args(.{ "--token", "from-args" })) ! { assert(false) return }
    assert(typed.value("token") == "from-args")

    core.unsetenv("TOOL_TOKEN") ! { assert(false) return }
    core.unsetenv("TOOL_DEBUG") ! { assert(false) return }
    let without = app.parse(args(.{})) ! { assert(false) return }
    assert(without.value("token") == "")
    assert(!without.flag("debug"))
}

synctest "An environment variable is held to the choices" {
    let app = cli.App.new("tool", "", "")
    app.root.option("mode", "m", "How to run", "fast", "mode", "TOOL_TEST_MODE", false, false, .{ "fast", "slow" })

    core.setenv("TOOL_TEST_MODE", "sideways") ! { assert(false) return }
    let refused = false
    app.parse(args(.{})) ! {
        refused = error_is(E.code, invalid_value) && E.message.contains("TOOL_TEST_MODE")
    }
    assert(refused)
    // What is typed wins, so the environment is not looked at
    assert((app.parse(args(.{ "--mode", "slow" })) ! { assert(false) return }).value("mode") == "slow")
    core.unsetenv("TOOL_TEST_MODE") ! { assert(false) return }
}

synctest "Help text lines up names that are not ASCII" {
    cli.colors = false
    let app = cli.App.new("tool", "", "")
    app.root.option("größe", "g", "Size", "", "wert")
    app.root.option("size", "s", "Size", "", "wert")
    app.root.command(cli.Command.new("über", "Over"))
    app.root.command(cli.Command.new("under", "Under"))
    let text = app.help()
    assert(text.contains("  -g, --größe <wert>  Size\n"))
    assert(text.contains("  -s, --size <wert>   Size\n"))
    assert(text.contains("  über   Over\n"))

    // A command that takes `-h` itself lists help without the letter
    let db = cli.App.new("db", "", "")
    db.root.flag("host", "h", "The host")
    assert(db.help().contains("      --help"))
}

fn with_globals() cli.App {
    let app = git_like()
    app.root.flag("verbose", "v", "Say more", "", true)
    app.root.option("config", "c", "The config file", "vcs.toml", "file", "VCS_TEST_CONFIG", false, false, .{}, true)
    return app
}

test "Global options are accepted by the commands under their command" {
    let app = with_globals()

    // After the subcommand, and after a command under it
    let ctx = app.parse(args(.{ "remote", "-v", "add", "origin", "url", "--config", "x.toml" })) ! {
        println(E.message)
        assert(false)
        return
    }
    assert(ctx.command.path() == "vcs remote add")
    assert(ctx.flag("verbose"))
    assert(ctx.value("config") == "x.toml")
    assert(ctx.arg("name") == "origin")

    // Before it, as before; the default reaches the subcommand as well
    let before = app.parse(args(.{ "--verbose", "add", "a.txt" })) ! { println(E.message) assert(false) return }
    assert(before.flag("verbose") && before.value("config") == "vcs.toml")

    // A switch that is not global stays with its own command
    let refused = false
    app.parse(args(.{ "add", "-q", "a.txt" })) ! { refused = error_is(E.code, unknown_flag) }
    assert(refused)

    // The subcommand's help lists them apart from its own options
    let help = cli.help_text(app.root.find("add") ?? cli.Command.new("?"))
    assert(help.contains("Global options:") && help.contains("-v, --verbose") && help.contains("--config <file>"))
    assert(!cli.help_text(app.root).contains("Global options:"))
}

test "A command cannot redeclare a global option" {
    let app = with_globals()
    let add = app.root.find("add") ?? cli.Command.new("?")
    add.flag("version-all", "v", "Clashes with -v")
    let message = ""
    app.parse(args(.{ "add", "a.txt" })) ! { message = E.message }
    assert(message == "'vcs add' declares -v, which the global option --verbose already uses")
}
